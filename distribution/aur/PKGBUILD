# Maintainer: paulcrook-dev <https://github.com/paulcrook-dev>
# Fork of k4dy/telegramtui that adds desktop notifications via notify-send.
# Builds from source against this fork (paulcrook-dev/telegramtui).
pkgname=telegramtui
pkgver=1.0.0
pkgrel=3
pkgdesc="Terminal Telegram client with a vim spirit (fork with notify-send notifications)"
arch=('x86_64' 'aarch64')
url="https://github.com/paulcrook-dev/telegramtui"
license=('MIT')
depends=('java-runtime>=21' 'telegram-tdlib')
makedepends=('maven')
source=("git+https://github.com/paulcrook-dev/telegramtui.git#branch=master")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname"
    mvn -q package -DskipTests
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm644 "target/telegramtui-$pkgver.jar" "$pkgdir/usr/share/$pkgname/$pkgname.jar"

    install -dm755 "$pkgdir/usr/bin"
    cat > "$pkgdir/usr/bin/$pkgname" << 'EOF'
#!/bin/bash
exec java -jar /usr/share/telegramtui/telegramtui.jar "$@"
EOF
    chmod +x "$pkgdir/usr/bin/$pkgname"
}